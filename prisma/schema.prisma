// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User Account
model User {
  id        String   @id // Clerk User ID
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())

  periods         BudgetPeriod[]
  settings        UserSettings?
  budgetTemplates BudgetTemplate[]
}

// User preferences for domain, currency, etc.
model UserSettings {
  id     Int    @id @default(autoincrement())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  currency      String  @default("USD")
  weekStart     Int     @default(0) // 0=Sunday, 1=Monday
  defaultDomain String  @default("TIME")
  defaultPeriod String  @default("WEEKLY")
  timeCapacity  Decimal @default(168) @db.Decimal(12, 2)

  // Income Management
  baseMoneyCapacity Float   @default(0) // Replacing fixed 0 capacity
  autoBudget        Boolean @default(true) // Copy previous budget values?
  fontFamily        String? @default("var(--font-courier-prime)")
  fontSize          Int     @default(18) // 16=Standard, 18=Large (Default/Courier), 20=Larger

  updatedAt DateTime @default(now()) @updatedAt
}

// A "Budget Period" container (e.g., Week of Dec 4th, or Month of Jan 2025)
model BudgetPeriod {
  id        Int      @id @default(autoincrement())
  startDate DateTime // The start date of the period
  type      String // "WEEKLY", "MONTHLY", "YEARLY"
  userId    String
  user      User     @relation(fields: [userId], references: [id])

  // State of the period
  isClosed Boolean @default(false)
  domain   String  @default("MONEY") // "TIME" or "MONEY"
  capacity Decimal @default(0) @db.Decimal(12, 2) // Total income or hours for this specific period

  templateId String? // The active template used to fund this period
  template   BudgetTemplate? @relation(fields: [templateId], references: [id])

  envelopes Envelope[]

  @@unique([userId, startDate, type, domain]) // One budget per period type per start date per domain
}

// The "Buckets" for a specific period
// e.g., "Work" for Week 42.
model Envelope {
  id    Int     @id @default(autoincrement())
  name  String // e.g., "Work", "Sleep", "Unallocated"
  color String? // UI color code

  budgeted Decimal @db.Decimal(12, 2) // The plan/target amount (e.g., 40.00)
  funded   Decimal @default(0) @db.Decimal(12, 2) // Actual money deposited (for MONEY domain)

  periodId Int
  period   BudgetPeriod @relation(fields: [periodId], references: [id])

  transactions Transaction[] @relation("EnvelopeTransactions")
  transfersTo  Transaction[] @relation("TransferToTransactions")
}

// The actual spending of time
model Transaction {
  id     Int     @id @default(autoincrement())
  amount Decimal @db.Decimal(12, 2) // e.g., 2.5 hours
  type   String  @default("EXPENSE") // "EXPENSE", "INCOME", "TRANSFER", "ADJUSTMENT"

  // New Metadata
  entity    String? // Acts as "Payee" for Expenses or "Payer" for Income
  refNumber String? // Reference number (Check #, Invoice #)

  description String? // "Deep work on Project X"
  date        DateTime // When it happened

  envelopeId Int // Primary envelope (Source for Expense/Transfer, Target for Income)
  envelope   Envelope @relation("EnvelopeTransactions", fields: [envelopeId], references: [id])

  // New: Transfer Support
  toEnvelopeId Int? // Target envelope (Only for TRANSFER type)
  toEnvelope   Envelope? @relation("TransferToTransactions", fields: [toEnvelopeId], references: [id])

  createdAt DateTime  @default(now())
  startTime DateTime? // Optional: For Time Range entries
  endTime   DateTime? // Optional: For Time Range entries

  isSystemAdjustment Boolean @default(false)
}

enum FundingMode {
  ADD
  RESET
}

enum TemplateFundingModeOverride {
  ADD
  RESET
  INHERIT
}

model BudgetTemplate {
  id                 String               @id @default(uuid())
  userId             String
  user               User                 @relation(fields: [userId], references: [id])
  name               String
  domain             String               @default("MONEY") // "MONEY" or "TIME"
  isActive           Boolean              @default(false)
  isBuiltIn          Boolean              @default(false)
  isAutoFillEnabled  Boolean              @default(false)
  defaultFundingMode FundingMode          @default(ADD)
  items              BudgetTemplateItem[]

  periods BudgetPeriod[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BudgetTemplateItem {
  id                  String                      @id @default(uuid())
  templateId          String
  template            BudgetTemplate              @relation(fields: [templateId], references: [id], onDelete: Cascade)
  envelopeName        String
  amount              Decimal                     @db.Decimal(12, 2)
  fundingModeOverride TemplateFundingModeOverride @default(INHERIT)
}
